{
  "expo": {
    "name": "market-place-app",
    "slug": "market-place-app",
    "scheme": "market-place-app",
    "experiments": {
      "typedRoutes": true
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brunodsazevedo.marketplaceapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "package": "com.brunodsazevedo.marketplaceapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Este app precisa de acesso às suas fotos para que você possa compartilhá-las com seus amigos.",
          "cameraPermission": "Este app precisa de acesso à sua câmera para que você possa tirar fotos e compartilhá-las com seus amigos."
        }
      ]
    ]
  }
}
